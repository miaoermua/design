# ── Mix Space 后端 ────────────────────────────────────────────────
# 后端 Origin（不含 /api/v2，也不要以斜杠结尾）。必填。
# 例：https://api.example.com
MX_SERVER_URL=

# 站点对外地址，用于 canonical / sitemap / RSS。必填（生产）。
# 例：https://example.com
NEXT_PUBLIC_SITE_URL=

# ── 主题 ──────────────────────────────────────────────────────────
# 主题配置 Snippet 的名称（reference = theme）
# 文档：GET /snippets/theme/<name>
MX_THEME_NAME=folio

# About 页面使用的 Page slug（GET /pages/slug/:slug）
MX_ABOUT_PAGE_SLUG=about

# 契约方言：本主题只实现 v2（core v12.x）。保留开关仅用于未来 v3 移植时的显式切换。
MX_API_VERSION=2

# 站点时区（用于归档与日记时间线的日期分组）
MX_SITE_TIMEZONE=Asia/Shanghai

# ── 开发/预览 ─────────────────────────────────────────────────────
# 1 = 使用内置 fixtures 渲染（离线预览与契约测试）。
# 仅在显式开启时生效，永不作为真实请求失败后的兜底。
MX_MOCK=0
