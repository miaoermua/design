# ── Mix Space 后端 ────────────────────────────────────────────────
# 后端 Origin（不含 /api/v2，也不要以斜杠结尾）。必填。
# 例：https://api.example.com
MX_SERVER_URL=

# 站点对外地址，用于 canonical / sitemap / RSS。必填（生产）。
# 例：https://example.com
NEXT_PUBLIC_SITE_URL=

# ── 主题 ──────────────────────────────────────────────────────────
# 主题 Snippet 名称。后端按 GET /snippets/theme/<name> 公开读取，
# 对应 Mix Space 后台里 reference=theme、type=yaml 的 Snippet。
# 同一个后端可挂多个主题，各自用不同名字，互不覆盖。
MX_THEME_NAME=folio

# 站点时区（用于归档与日记时间线的日期分组）
MX_SITE_TIMEZONE=Asia/Shanghai

# ── 实时更新（可选）──────────────────────────────────────────────
# 默认取 MX_SERVER_URL 的 origin：https://api.example.com/api/v2 → https://api.example.com
# Socket.IO 客户端固定连 /socket.io/（Engine.IO path）下的 /web namespace，
# 只用 WebSocket transport，不提供 polling 或旧版协议的降级。
# 需要反代到别的主机时显式覆盖（只接受不带路径的 http(s) origin；旧的 ws://、wss:// 一律拒绝）：
# MX_REALTIME_URL=https://api.example.com
# 关闭实时连接（不连接、不轮询，也不显示连接状态胶囊）：
# MX_REALTIME=off

# ── 开发/预览 ─────────────────────────────────────────────────────
# 1 = 使用内置 fixtures 渲染（离线预览与契约测试）。
# 仅在显式开启时生效，永不作为真实请求失败后的兜底。
MX_MOCK=0

# 可选：API 超时毫秒数，默认 15000。
# MX_API_TIMEOUT_MS=15000
